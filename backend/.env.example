# mock | claude | gemini | groq | openrouter | ollama
LLM_PROVIDER=gemini
# tried in order if the primary fails (rate limit, bad Wi-Fi...)
LLM_FALLBACKS=groq,openrouter,ollama

ANTHROPIC_API_KEY=     # https://platform.claude.com (API credits)
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GROQ_API_KEY=          # https://console.groq.com/keys
OPENROUTER_API_KEY=    # https://openrouter.ai/keys
OLLAMA_BASE_URL=http://localhost:11434/v1

# optional model overrides
# CLAUDE_MODEL=claude-opus-5-5   # claude-haiku-5-5 makes credits last longer
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/free
# OLLAMA_MODEL=llama3.2:3b
# YOLO_MODEL=yolo11n.pt

CORS_ORIGINS=*
