# mock | claude | gemini | groq | openrouter | ollama
LLM_PROVIDER=gemini
# tried in order if the primary fails (rate limit, bad Wi-Fi...)
LLM_FALLBACKS=groq,openrouter,ollama

ANTHROPIC_API_KEY=     # https://platform.claude.com (API credits)
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GROQ_API_KEY=          # https://console.groq.com/keys
OPENROUTER_API_KEY=    # https://openrouter.ai/keys
OLLAMA_BASE_URL=http://localhost:11434/v1

# optional model overrides
# CLAUDE_MODEL=claude-opus-5-5   # claude-haiku-5-5 makes credits last longer
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/free
# OLLAMA_MODEL=llama3.2:3b         # or nemotron-mini: offline last resort for the text-only steps (context fix, table)
# YOLO_MODEL=yolo11n.pt

CORS_ORIGINS=*

# ---------- ClearScript handwriting pipeline (all optional, defaults shown) ----------
# Voters: comma-separated provider:model; "|" lists spare models for the same voter (used when one runs out of quota)
# HW_READERS=groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash|gemini:gemini-3.7-flash|gemini:gemini-3.1-flash-lite,openrouter:dots-studio/dots-3-note-preview:free,gemini:gemini-3.6-flash|gemini:gemini-3.8-flash|gemini:gemini-3.7-flash|gemini:gemini-3.1-flash-lite,openrouter:google/gemma-4-31b-it:free|openrouter:google/gemma-4-26b-a4b-it:free
# HW_BASELINE=groq:qwen/qwen3.8-27b   # single model, plain prompt: what we compare against
# HW_FLAG_RULE=two_thirds             # readers that must agree to trust a word: majority | two_thirds | unanimous
# HW_FLAG_RULE_RX=unanimous           # same, for prescriptions (safety first)
# HW_DIGITS_STRICT=1                  # 1 = any disagreement on a number is flagged
# HW_DROP_MINORITY=1                  # 1 = a word fewer than half the readers saw is dropped
# HW_REREAD_MODE=off                  # vote | suggest | off: context-aware re-read of flagged words
# HW_PROMPT=v1                        # v2 = also ignore printed text and crossed-out words
# HW_VOTE_DEADLINE=60                 # s per page to wait for every reader; then vote with whoever answered
# HW_READ_TIMEOUT=90                  # s per model call
# HW_RETRY_WAIT=2                     # s to wait before the one retry on 429 / 503
# HW_CACHE_ONLY=                      # 1 = never call cloud vision models, replay backend/.cache (local ollama: readers still run)

# ---------- Upload limits, rate limits, load (all optional, defaults shown) ----------
# MAX_UPLOAD_MB=15                    # handwriting photo / PDF (bigger -> 413)
# DOCS_MAX_UPLOAD_MB=10               # Docs Q&A upload
# OPENCV_IO_MAX_IMAGE_PIXELS=60000000 # refuse decompression bombs (tiny file, huge image)
# HW_MAX_CONCURRENT=4                 # digitize jobs at once; more -> 503 busy
# RATE_LIMIT_OFF=                     # 1 = no rate limits (local testing)
# RATE_LIMIT_DIGITIZE=10/60           # requests per seconds per client IP: /api/handwriting and /stream together
# RATE_LIMIT_DOCS_UPLOAD=20/60
# RATE_LIMIT_DOCS_ASK=30/60
# RATE_LIMIT_HW_TOOLS=60/60           # /api/handwriting/answer, /table, /recontext
# TRUST_PROXY=                        # 1 = behind one reverse proxy (Render): client IP from X-Forwarded-For

# Supabase (optional): durable copy of the reading cache and writer profiles, so a Render restart loses nothing.
# Create the tables once with backend/supabase.sql. Server-side only; never put this key in the frontend.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
