# Leave empty in dev (Vite proxies /api). On Vercel set it to your Render URL.
VITE_API_URL=

# Firebase sign-in + synced history (optional). Copy this file to .env.local and fill these in from
# Firebase console > Project settings > Your apps > Web app. Leave empty to run without accounts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
