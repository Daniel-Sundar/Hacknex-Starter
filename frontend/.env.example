# Leave empty in dev (Vite proxies /api). On Render it is set in render.yaml.
VITE_API_URL=

# Supabase sign-in + synced history (optional). Copy this file to .env.local and fill these in from
# Supabase > Project Settings > API Keys: the Project URL and the PUBLISHABLE key (never the secret key).
# Leave empty to run without accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
